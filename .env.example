# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (optional, for Needlebot)
OPENAI_API_KEY=your-openai-api-key

# YouTube Data API v3 (for in-app track search)
YOUTUBE_API_KEY=your-youtube-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stress harness (optional — unset disables /api/admin/stress)
# Used for manual/API calls (Authorization: Bearer … or x-stress-secret).
STRESS_TEST_SECRET=generate-a-long-random-string

# Required for Vercel Cron in production: Vercel sends Authorization: Bearer CRON_SECRET.
# STRESS_TEST_SECRET alone is not enough for scheduled cron ticks.
CRON_SECRET=generate-a-long-random-string
